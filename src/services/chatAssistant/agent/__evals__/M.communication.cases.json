    "expect": {
      "tools": [
        "search_my_mailbox"
      ],
      "args": {
        "search_my_mailbox": {
          "query": "invoice"
        }
      }
    }
  },
  {
    "id": "m-mailbox-summarise-thread-followup",
    "history": [
      {
        "role": "user",
        "content": "find the invoice email"
      },
      {
        "role": "assistant",
        "content": "I found one thread: \"Invoice for September\" from Acme Billing."
      }
    ],
    "ledger": [
      {
        "calls": [
          {
            "tool": "search_my_mailbox",
            "args": {
              "query": "invoice"
            },
            "total": 1
          }
        ]
      }
    ],
    "question": "summarise that thread for me",
    "expect": {
      "tools": [
        "search_my_mailbox"
      ],
      "args": {
        "search_my_mailbox": {
          "threadId": "t1",
          "accountId": "a1"
        }
      },
      "maxCalls": 2
    }
  },
  {
