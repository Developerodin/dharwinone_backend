      "anyOf": [
        { "tools": ["list_my_files"], "args": { "list_my_files": { "search": "invoice" } } },
        { "tools": ["list_my_files"], "args": { "list_my_files": { "search": "invoice.xlsx" } } }
      ]
    }
  },
  {
