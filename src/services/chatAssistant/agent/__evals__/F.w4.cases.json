        { "tools": ["list_my_files"], "args": { "list_my_files": { "search": "brd" } } },
        { "tools": ["list_my_files"], "args": { "list_my_files": { "search": "project BRD" } } }
      ]
    }
  },
  {
    "id": "f-w4-search-invoice",
