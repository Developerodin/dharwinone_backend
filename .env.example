NODE_ENV=development

# Port number
PORT=3000

# Reverse proxy hops for Express req.ip (platform audit IP, rate limits). 0 = direct Node (local dev). AWS: usually 1 behind a single ALB; 2 if CloudFront (or another proxy) sits in front of ALB—match your real hop count.
# TRUST_PROXY_HOPS=0
# Optional: TRUST_PROXY=true enables app.set('trust proxy', true) when hops=0. Prefer TRUST_PROXY_HOPS=1 behind one nginx/ALB.
# Nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# TRUST_PROXY=true

# Default JSON body size for most /v1 routes (DoS surface). app.js defaults to 512kb if unset.
# JSON_BODY_LIMIT=512kb
# Larger payloads only for /v1/pm-assistant/* (task breakdown / apply). Defaults to 2mb if unset.
# JSON_BODY_LIMIT_HEAVY=2mb

# URL of the Mongo DB (app runtime - not used by mirror-cloud-to-local.js)
MONGODB_URL=mongodb://127.0.0.1:27017/node-boilerplate

# ========== Cloud -> local mirror (scripts/mirror-cloud-to-local.js) ==========
# Safety gate: script refuses to run unless this is exactly true (case-insensitive). No CLI bypass.
# MIRROR_CLOUD_TO_LOCAL_ENABLED=true
# Required when mirroring: Atlas/cloud source (read-only; no fallback to MONGODB_URL)
# CLOUD_MONGODB_URL=mongodb+srv://user:pass@cluster.example.net/uat-dharwin
# Required when mirroring: local target (must be loopback/private IP unless --force)
# LOCAL_MONGODB_URL=mongodb://127.0.0.1:27017/uat-dharwin
# Optional: directory for pre-upsert local backups (default: backups/mirror-local-YYYY-MM-DD-HHmmss/)
# MIRROR_BACKUP_DIR=backups
# Optional: ms to wait for server selection (default 30000 in development, 10000 in production)
# MONGOOSE_SERVER_SELECTION_MS=30000

# JWT — minimum 32 characters (enforced by config validation)
JWT_SECRET=thisisasamplesecretkeywith32chars!
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=30
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
# Default in config.js is 1440 (24h) if unset
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=1440

# Auth / API hardening (optional)
# Production defaults: tokens only in HttpOnly cookies (not in JSON); OpenAPI spec hidden unless enabled.
# AUTH_RETURN_TOKENS_IN_JSON=true
# EXPOSE_OPENAPI=true
# BCRYPT_SALT_ROUNDS=12

# SMTP (transactional mail via Nodemailer — Microsoft 365 / Outlook example below)
# Do not use service: "gmail" in code; host/port/auth come from these env vars only.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_TIMEOUT=7
SMTP_USERNAME=no-reply@dharwinbusinesssolutions.com
SMTP_PASSWORD=
# TLS certificate verification for SMTP (default: verify). Set to false only for dev servers with self-signed certs.
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# Visible From (e.g. no-reply@yourdomain.com); display name "Dharwin Business Solutions" is added in code unless you use Name <addr> format.
EMAIL_FROM=no-reply@dharwinbusinesssolutions.com
EMAIL_REPLY_TO=no-reply@dharwinbusinesssolutions.com

# ========== REQUIRED FOR DEPLOYMENT - Email/Share Links ==========
# Without these, all emails and share links will contain localhost URLs.
# See DEPLOYMENT_URLS.md in project root for full guide.

# Frontend base URL (reset-password, verify-email, sign-in, onboarding links in emails)
# Production: https://dharwinone.com
FRONTEND_BASE_URL=http://localhost:3001
# FRONTEND_BASE_URL=https://dharwinone.com

# CORS — comma-separated browser origins allowed with credentials (e.g. https://dharwinone.com,https://www.dharwinone.com).
# REQUIRED when NODE_ENV=production (server will not start without it).
# CORS_ORIGIN=http://localhost:3001

# Backend public URL (share links, document downloads, webhooks)
# Production: https://apis.yourdomain.com
# BACKEND_PUBLIC_URL=http://localhost:3000
# BACKEND_PUBLIC_URL=https://apis.dharwinone.com

# LiveKit Configuration
# --- Option A: Local Docker ---
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=devsecret123456789012345678901234
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_BUCKET=recordings

# --- Option B: LiveKit Cloud (no Docker) ---
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=your_api_key_from_cloud_project
LIVEKIT_API_SECRET=your_api_secret_from_cloud_project
# Recordings: use AWS S3 (set AWS credentials and bucket below)

# AWS S3 (chat attachments, documents, offer letters � required on Render)
# Region must match the bucket region (S3 console ? bucket ? Properties).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

LIVEKIT_S3_BUCKET=recordings
# Dispatch meeting-summary + meeting-assistant agents on record / host join (default true)
# LIVEKIT_AGENTS_ENABLED=false

# MinIO (only for Option A)
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_BUCKET=recordings

# OpenAI – blog AI, module generation, and DALL-E cover images
OPENAI_API_KEY=

# Resume skill extraction (Personal Information → Skills). Uses OPENAI_API_KEY; optional model override:
# RESUME_SKILLS_OPENAI_MODEL=gpt-4o-mini
# Skill recommendation by job role (POST /auth/me/recommend-skills-by-role) uses the same model.
# Optional: cap JSON output tokens for faster suggestions (default 1536).
# RECOMMEND_SKILLS_MAX_TOKENS=1536

# PM assistant (GPT task breakdown + assignment runs). Enabled when OPENAI_API_KEY is set, or set PM_ASSISTANT_ENABLED=true.
# Opt out: PM_ASSISTANT_ENABLED=false
# Optional overrides (defaults: gpt-4o-mini / gpt-4o):
# PM_OPENAI_MODEL=gpt-4o-mini
# PM_OPENAI_MODEL_ESCALATION=gpt-4o

# GCP (YouTube + Gmail OAuth)
GCP_YOUTUBE_API_KEY=
GCP_GOOGLE_CLIENT_ID=
GCP_GOOGLE_CLIENT_SECRET=
GCP_GOOGLE_REDIRECT_URI=http://localhost:3000/v1/email/auth/google/callback
# Native app Google OAuth clients (installed/PKCE, no secret) — used to refresh tokens
# minted by the mobile app (refresh tokens are bound to their issuing client_id).
GCP_GOOGLE_APP_CLIENT_ID_ANDROID=
GCP_GOOGLE_APP_CLIENT_ID_IOS=

# Expo push notifications (optional access token; push works without it)
EXPO_ACCESS_TOKEN=

# Microsoft Outlook (Graph API) — Azure Portal > App registrations
# Redirect URI (Web): {BACKEND_PUBLIC_URL}/v1/outlook/auth/microsoft/callback
# Delegated permissions: Mail.ReadWrite, Mail.Send, User.Read (+ admin consent if org)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must match Azure "Redirect URI" exactly (path + port, backend host — not frontend).
MICROSOFT_REDIRECT_URI=http://localhost:3000/v1/outlook/auth/microsoft/callback
MICROSOFT_TENANT_ID=common
# Mobile app's separate Azure registration (public/PKCE client; react-native-app-auth).
# Required so mailboxes connected from the app can be refreshed (refresh tokens are bound to
# their issuing client_id). Defaults its tenant to MICROSOFT_TENANT_ID when blank.
MICROSOFT_APP_CLIENT_ID=
MICROSOFT_APP_TENANT_ID=
# Set to 1 to log raw Graph inbox probe on each listThreads (see server stderr)
# OUTLOOK_DEBUG_GRAPH=1

# Attendance — max hours counted/stored for a single punch session (prevents 200h+ calendar cells from forgotten punch-out / import bugs). Default 24.
# ATTENDANCE_MAX_SESSION_HOURS=24
# Max hours summed per calendar day across multiple punch sessions (prevents 24h+24h=48h when capped sessions stack). Default 24 wall-clock hours.
# ATTENDANCE_MAX_HOURS_PER_CALENDAR_DAY=24

# Candidate scheduler interval (minutes): resign deactivate, joining reminders, Candidate→Employee promotion, auto-expire offers. Default 5.
# CANDIDATE_SCHEDULER_INTERVAL_MINUTES=5

# Bolna Calling Configuration
# API key from Bolna dashboard
BOLNA_API_KEY=
# Job posting / recruiter verification (no in-app prompt PATCH — use Bolna dashboard prompt for this agent)
BOLNA_AGENT_ID=
# Applicant verification after apply (app PATCHes system prompt before each call). MUST differ from BOLNA_AGENT_ID or both flows break.
BOLNA_CANDIDATE_AGENT_ID=
# Extra/retired agent IDs to ALSO pull executions + recordings from (comma-separated).
# Set to the OLD job-verification agent's ID after switching BOLNA_AGENT_ID to a new agent,
# so historical calls/recordings on the old agent keep syncing and archiving.
BOLNA_ADDITIONAL_AGENT_IDS=
# Caller ID used for outbound calls (E.164 format, e.g. +18336990430)
BOLNA_FROM_PHONE_NUMBER=
# Retired Bolna caller IDs still present in call history (comma-separated, E.164).
# Classification only � outbound calls always use BOLNA_FROM_PHONE_NUMBER.
BOLNA_ADDITIONAL_FROM_NUMBERS=
# Optional fallback for caller ID (AddOn compatibility)
CALLER_ID=
# Bolna API base URL
BOLNA_API_BASE=https://api.bolna.ai
# Max call length in seconds (900 = 15 min). Sent on POST /call as max_call_duration_seconds when > 0.
# If calls still drop after ~90–120s, raise "Total Call Timeout" in Bolna → each agent → Call tab (dashboard limit often overrides or caps API).
# Set 0 to omit max_call_duration_seconds (then only the Bolna Call tab applies).
BOLNA_MAX_CALL_DURATION_SECONDS=900
# Shared secret for Bolna webhooks (POST / and /v1/webhooks/bolna-*). Send the same value in header X-Bolna-Webhook-Secret.
# Required in production (configure Bolna or a reverse proxy to forward the header).
# BOLNA_WEBHOOK_SECRET=

# Plivo Phone Numbers (search + buy) + click-to-call dialer
# HTTP Basic auth credentials from the Plivo console (Account > Keys & Credentials)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Public base URL Plivo fetches the call answer-XML from (POST /v1/plivo/call → bridge).
# MUST be publicly reachable — Plivo's cloud hits it, so localhost fails.
#   Render: leave blank — auto-falls back to RENDER_EXTERNAL_URL. Or set explicitly:
# 
# Telephony provider (plivo | twilio) � see docs/TWILIO_CUTOVER.md
TELEPHONY_PROVIDER=plivo
TWILIO_AUTH_ID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_WEBHOOKS=true
PLIVO_ANSWER_BASE_URL=https://your-app.onrender.com
#   EC2 / self-host: set to your public API URL (also set BACKEND_PUBLIC_URL):
# 
# Telephony provider (plivo | twilio) � see docs/TWILIO_CUTOVER.md
TELEPHONY_PROVIDER=plivo
TWILIO_AUTH_ID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_WEBHOOKS=true
PLIVO_ANSWER_BASE_URL=https://apis.dharwinone.com
#   Local dev: an ngrok tunnel, e.g. 
# Telephony provider (plivo | twilio) � see docs/TWILIO_CUTOVER.md
TELEPHONY_PROVIDER=plivo
TWILIO_AUTH_ID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_WEBHOOKS=true
PLIVO_ANSWER_BASE_URL=https://abc123.ngrok-free.app

# Telephony provider (plivo | twilio) � see docs/TWILIO_CUTOVER.md
TELEPHONY_PROVIDER=plivo
TWILIO_AUTH_ID=
TWILIO_AUTH_TOKEN=
TWILIO_API_SID=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_VERIFY_WEBHOOKS=true
PLIVO_ANSWER_BASE_URL=

# Max upload bytes for POST /v1/upload/single (default 25MB).
# UPLOAD_MAX_FILE_BYTES=26214400
# Max bytes per file in training module multer routes (default 80MB).
# TRAINING_MODULE_MAX_UPLOAD_BYTES=83886080

# ========== Voice agent knowledge base (RAG) ==========
# Requires OPENAI_API_KEY for embeddings + query. Tune KB_MIN_SIMILARITY on real data (e.g. 0.25–0.35).
KB_EMBEDDING_MODEL=text-embedding-3-small
# Optional: truncate embedding dimensions (256–3072). Leave unset or empty for model default.
# KB_EMBEDDING_DIMENSIONS=
KB_CHUNK_TARGET_TOKENS=768
KB_CHUNK_OVERLAP_TOKENS=128
KB_TOP_K=8
KB_MIN_SIMILARITY=0.28
KB_MAX_PDF_MB=25
KB_MAX_URL_BYTES=2097152
KB_MAX_DOCS_PER_AGENT=50
KB_QUERY_CACHE_TTL_SECONDS=3600
KB_QUERY_CACHE_MISS_TTL_SECONDS=120
MONGODB_VECTOR_SEARCH_ENABLED=false

# ========== Vector database (semantic search) ==========
# Which store the chatbot's semantic search reads and the embedding sync writes.
#   pinecone -> managed Pinecone (needs PINECONE_API_KEY / PINECONE_INDEX)
#   qdrant   -> Qdrant at QDRANT_URL; run it locally with
#               docker compose -f docker-compose.qdrant.yml up -d
# Both implement the same contract, so this is a straight swap — but the newly
# selected store starts EMPTY. Run the embedding sync once after switching;
# vectors are not replicated between the two.
VECTOR_DB=pinecone
QDRANT_URL=http://127.0.0.1:6333
# Blank for the local container; required for Qdrant Cloud.
QDRANT_API_KEY=
# Blank -> falls back to PINECONE_INDEX so both backends share one naming scheme.
# Collections are created as <prefix>__<namespace>, e.g. dharwin-hr__employees.
QDRANT_COLLECTION_PREFIX=

# ========== Bolna hosted Knowledge Base sync (optional) ==========
# When true, PDF + URL ingests also call Bolna POST /knowledgebase (same BOLNA_API_KEY). Attach RAG IDs in Bolna → Agent → LLM → knowledge bases.
KB_BOLNA_SYNC_ENABLED=true
KB_BOLNA_KB_MULTILINGUAL=false
KB_BOLNA_KB_CHUNK_SIZE=512
KB_BOLNA_KB_OVERLAPPING=128
KB_BOLNA_KB_SIMILARITY_TOP_K=15

# RapidAPI key for External Jobs (Active Jobs DB / LinkedIn Jobs API)
RAPIDAPI_KEY=

# Comma-separated emails allowed to use Activity Logs API/UI and support camera invites. When unset, defaults to harvinder@superadmin.in.
# DESIGNATED_SUPERADMIN_EMAILS=harvinder@superadmin.in

# ========== HRM WebRTC (Windows agent + SignalR) ==========
# Mint admin JWTs for the hrm-webrtc/backend hub. Values must match that service's Jwt:Key, Jwt:Issuer, Jwt:Audience (see hrm-webrtc/backend/Program.cs).
# HRM_WEBRTC_JWT_SECRET=
# HRM_WEBRTC_JWT_ISSUER=
# HRM_WEBRTC_JWT_AUDIENCE=
# Base URL of the HRM backend (no trailing slash). Returned to the browser for SignalR; optional if NEXT_PUBLIC_HRM_WEBRTC_BACKEND_URL is set on the frontend.
# HRM_WEBRTC_SIGNALING_BASE_URL=https://your-hrm-backend.example.com
# HRM_WEBRTC_TOKEN_EXPIRATION_MINUTES=15

# Apollo.io — HR contact enrichment for External Jobs
# Get your Master API key from Apollo Settings > Integrations > API
# APOLLO_IO_API_KEY=

# Apollo webhook secret — include this in the webhook URL path to prevent spoofing
# APOLLO_WEBHOOK_SECRET=your-random-secret-here

# Chatbot — two-stage pipeline (classifier + scoped fetcher). Default off; flip to true to enable.
CHATBOT_TWO_STAGE=false

# Chatbot — canonical employee entityQuery pipeline (fixes unpaid-employee hallucination).
# When true, employee filter queries route through StructuredQuery → queryCandidates with
# deterministic rendering (pre-OpenAI short-circuit). Default false until UAT sign-off.
CHATBOT_ENTITY_QUERY_EMPLOYEES=false
# Percent rollout when flag is on (stable hash on user id); 100 = all enrolled users, 0 = none.
CHATBOT_ENTITY_QUERY_EMPLOYEES_PERCENT=100
# Include raw mongo filter in employee query audit logs — incident response only; default false.
CHATBOT_QUERY_AUDIT_DEBUG=false

# Task board V2 runtime feature flag (GET /v1/feature-flags/taskboard-v2)
# Rollout: off | internal | tenant-allowlist | all (V1 UI removed; default all)
FEATURE_FLAG_TASKBOARD_V2_ROLLOUT=all
# Comma-separated emails always enabled (userOverride), even when rollout is off
# FEATURE_FLAG_TASKBOARD_V2_ALLOWLIST=admin@example.com,qa@example.com

# Interview scheduler — T-15 reminders and post-interview conclusion notifications
MEETING_SCHEDULER_INTERVAL_MINUTES=5
INTERVIEW_REMINDER_CONCURRENCY=5
REMINDER_TIMEOUT_MS=10000
REMINDER_LEASE_TTL_MS=600000
REMINDER_WINDOW_START_MIN=15
REMINDER_WINDOW_END_MIN=20
CONCLUSION_DELAY_MIN=15


# Contact lookup audit/rate limits (optional)
# CONTACT_LOOKUP_HASH_SECRET=
CONTACT_LOOKUP_PER_MINUTE=20
CONTACT_LOOKUP_PER_MINUTE_PER_IP=40

# Mobile app version check (GET /v1/app/version) � bump when a new build is published
MOBILE_APP_LATEST_VERSION=1.0.0
